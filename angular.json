{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": { "analytics": false },
  "projects": {
    "healthinsurance-kcs": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/healthinsurance-kcs",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              { "glob": "**/*", "input": "src/assets", "output": "assets" },
              { "glob": "staticwebapp.config.json", "input": ".", "output": "/" },
              { "glob": "_headers", "input": "public", "output": "/" }
            ],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "350kB", "maximumError": "500kB" },
                { "type": "anyComponentStyle", "maximumWarning": "12kB", "maximumError": "16kB" }
              ],
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": true }, "fonts": false }
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "healthinsurance-kcs:build:production" },
            "development": { "buildTarget": "healthinsurance-kcs:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
